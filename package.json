{
  "name": "antigravity-notifier",
  "version": "1.0.0",
  "description": "让反重力 (Google Antigravity) 通过 QQ、微信、Bark、ntfy 等推送任务完成情况与等待状态。Push notification daemon for Google Antigravity to send task completion alerts via QQ (Qmsg), WeChat (ServerChan/WeCom), iOS Bark, and ntfy.",
  "main": "src/index.js",
  "bin": {
    "antigravity-notifier": "bin/notifier.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrNoir-520/antigravity-notifier.git"
  },
  "homepage": "https://github.com/DrNoir-520/antigravity-notifier#readme",
  "bugs": {
    "url": "https://github.com/DrNoir-520/antigravity-notifier/issues"
  },
  "scripts": {
    "start": "node bin/notifier.js start",
    "daemon": "node bin/notifier.js daemon",
    "test": "node test/test_all.js && node test/test_ascii_comments.js",
    "install-service": "powershell -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "uninstall-service": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-service.ps1"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "gemini",
    "gemini-cli",
    "qq-push",
    "wechat-push",
    "qmsg",
    "serverchan",
    "wecom",
    "bark",
    "ntfy",
    "task-completion-alert",
    "mobile-notification",
    "push-notification",
    "stealth-mode",
    "windows-task-scheduler"
  ],
  "author": "DrNoir-520",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
